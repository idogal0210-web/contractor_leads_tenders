# =============================================================================
# Contractor Leads & Tenders Management System — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Gemini AI
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Supabase / Database
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_DB_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Redis (Celery broker & result backend)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# SMTP / Email
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com

# -----------------------------------------------------------------------------
# Telegram Notifications
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# Application / Business Logic
# -----------------------------------------------------------------------------
# Profile ID of the active contractor (matches config/contractor_profile.json)
CONTRACTOR_PROFILE_ID=1

# Daily scan times (comma-separated, HH:MM 24h format, Israel time)
SCAN_TIMES=06:00,12:00,18:00

# Fast-track thresholds — leads exceeding ALL three are processed immediately
FAST_TRACK_BUSINESS_FIT_THRESHOLD=80
FAST_TRACK_URGENCY_THRESHOLD=70
FAST_TRACK_CONFIDENCE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change_me_in_production
